# Python
__pycache__/
*.pyc

backend/venv/
backend/.env
.env

# Catalyst AppSail vendored dependencies: the predeploy/preserve scripts
# (app-config.json) pip-install requirements.txt into this dedicated
# subdirectory (never into backend/ itself — see run.py's sys.path comment)
# so they ship in the bundle without ever colliding with local dev's own
# .venv. Regenerated on every `catalyst deploy appsail`.
backend/vendor/

# Catalyst Client build output (catalyst.json's client.source) — copied from
# frontend/dist by the client predeploy script, not source.
backend/client/

backend.zip

# Node
frontend/node_modules/
frontend/dist/

# Editor/OS
.vscode/
.DS_Store
.env
